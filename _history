ay][y_lay - 1] = 0\n        }\n    }\n}\n// Aボタンを押下した時にx軸上を移動\ninput.onButtonPressed(Button.A, function () {\n    music.playTone(784, music.beat(BeatFraction.Sixteenth))\n    if (x_lay == 4) {\n        x_lay = 0\n    } else {\n        x_lay += 1\n    }\n})\n// A+Bボタンを押下した時にその点と周りの点灯が反転\n// その点を反転\ninput.onButtonPressed(Button.AB, function () {\n    music.playTone(932, music.beat(BeatFraction.Sixteenth)\n       push_count += 1\n    LightUp(x_lay, y_lay)\n})\n// Bボタンを押下した時にy軸上を移動\ninput.onButtonPressed(Button.B, function () {\n    music.playTone(784, music.beat(BeatFraction.Sixteenth))\n    if (y_lay == 4) {\n        y_lay = 0\n    } else {\n        y_lay += 1\n    }\n})\nlet count = 0\nlet push_count = 0\nlet y_lay = 0\nlet x_lay = 0\nlet random_y = 0\nlet random_x = 0\nlet mass: number[][] = []\nlet row: number[] = []\n// 配列の全ての中身を0にする\nfor (let index = 0; index < 5; index++) {\n    row = []\n    // 配列の中身を0にする\n    for (let index = 0; index < 5; index++) {\n        row.push(0)\n    }\n    mass.push(row)\n}\n// ランダムな数を光らせる\nlet random = randint(5, 20)\nfor (let index = 0; index < random; index++) {\n    // ランダムな座標を1にする\n    random_x = randint(0, 4)\n    random_y = randint(0, 4)\n    LightUp(random_x, random_y)\n}\nbasic.forever(function () {\n    count = 0\n    for (let count_x = 0; count_x <= 4; count_x++) {\n        for (let count_y = 0; count_y <= 4; count_y++) {\n            if (mass[count_x][count_y] == 1) {\n                led.plotBrightness(count_x, count_y, 100)\n                count += 1\n            } else {\n                led.unplot(count_x, count_y)\n            }\n        }\n    }\n    // 今選択しているマスを光らせる\n    if (mass[x_lay][y_lay] == 1) {\n        led.plotBrightness(x_lay, y_lay, 255)\n    } else {\n        led.plotBrightness(x_lay, y_lay, 20)\n    }\n    if (count == 25) {\n        basic.showString(\"CLEAR\" + push_count)\n        control.reset()\n\n    }\n})\n","README.md":"","pxt.json":"{\n    \"name\": \"lights_out_program_test\",\n    \"descript